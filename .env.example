# ==============================================================
# UMLAPSO BOT - CONFIGURAÇÕES DE PRODUÇÃO (.env)
# ==============================================================

# 1. Inteligência Artificial (Roteiro e Metadados)
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY=""

# 2. Google Flow / Veo (ID do Projeto Fixo)
FLOW_PROJECT_ID="5240fab7-daab-46f2-85c9-de14684a1c2d"

# 3. Meta / Instagram Graph API Oficial
INSTAGRAM_ACCESS_TOKEN="EAAOC..."
INSTAGRAM_ACCOUNT_ID="17841456066138036"
META_GRAPH_API_VERSION="v21.0"

# 4. TikTok Oficial (Direct Post / Automação)
TIKTOK_ENABLED="true"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:8080/callback"

# 5. Configurações de Execução no Servidor Linux
# Em servidores sem interface gráfica, use 'true' para rodar em segundo plano,
# ou instale e use 'xvfb-run -a python main.py' para emulação de tela.
PLAYWRIGHT_HEADLESS="true"
TIMEZONE="America/Sao_Paulo"
