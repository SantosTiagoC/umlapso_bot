[Unit]
Description=Umlapso Bot - Gerador e Publicador Automatico de Shorts/Reels/TikTok
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Ajuste o User e o WorkingDirectory para o caminho real do seu servidor Ubuntu
User=ubuntu
WorkingDirectory=/home/ubuntu/umlapso_bot
EnvironmentFile=/home/ubuntu/umlapso_bot/.env
ExecStart=/usr/bin/xvfb-run -a /home/ubuntu/umlapso_bot/venv/bin/python /home/ubuntu/umlapso_bot/main.py --auto
StandardOutput=append:/home/ubuntu/umlapso_bot/logs/umlapso_bot.log
StandardError=append:/home/ubuntu/umlapso_bot/logs/umlapso_bot.log
Restart=no

[Install]
WantedBy=multi-user.target
